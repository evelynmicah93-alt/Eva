# PROVIDER: Select the active Gemma 4 provider.
# Options: "api" (Google AI Studio Gemini API) or "local" (Local Ollama)
PROVIDER="api"

# GEMINI_API_KEY: Required when PROVIDER="api".
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMMA_API_MODEL: Google AI Studio Gemma 4 model ID.
# Defaults to "gemma-4-26b-a4b-it" (or "gemma-4-31b-it")
GEMMA_API_MODEL="gemma-4-26b-a4b-it"

# OLLAMA_ENDPOINT: Local Ollama URL when PROVIDER="local".
OLLAMA_ENDPOINT="http://localhost:11434"

# OLLAMA_MODEL: Model tag inside local Ollama.
OLLAMA_MODEL="gemma4:e2b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
